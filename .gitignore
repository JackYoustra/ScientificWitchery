# dependencies
/node_modules

# testing
/coverage

# next.js
/.next/
/out/
.vercel

# production
/build

# rss feed (generated by scripts/postbuild.mjs)
/public/feed.xml
/public/tags/

# search
/public/search.json

# misc
.DS_Store

# debug
*.log
npm-debug.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Velite (generated content layer)
.velite

# TypeScript incremental build state (tsc --noEmit still writes this)
*.tsbuildinfo

# agent worktrees and local session state
.claude/
