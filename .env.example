# Comments are Giscus. Visit https://giscus.app to generate these four values
# for the repo backing the discussions.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
