# Comments are switched off — nothing renders them today. These are kept, along
# with the `comments` block in data/siteMetadata.js, so restoring Giscus is a
# one-component job. Visit https://giscus.app to generate the four values for
# the repo backing the discussions.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Umami analytics website ID. Kept in an env var so clones don't report into
# this site's analytics; leave empty to disable.
NEXT_UMAMI_ID=

# Newsletter signups go to Buttondown.
BUTTONDOWN_API_KEY=
