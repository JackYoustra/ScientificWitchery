{
  "name": "scientific-witchery",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "start": "next dev",
    "content": "velite build",
    "content:watch": "velite build --watch",
    "dev": "concurrently -k -n content,next -c blue,magenta \"velite build --watch\" \"cross-env INIT_CWD=$PWD next dev\"",
    "build": "cross-env INIT_CWD=$PWD NODE_ENV=production velite build && cross-env INIT_CWD=$PWD next build && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "wasm": "cd rust-wasm && RUSTFLAGS='-C target-feature=-reference-types' wasm-pack build --target bundler --out-dir pkg && rm -f pkg/.gitignore",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --fix --dir app --dir components --dir lib --dir layouts --dir scripts",
    "spell": "cspell data/blog/**/*.mdx",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@headlessui/react": "1.7.19",
    "@kbox-labs/react-echarts": "1.0.3",
    "@next/bundle-analyzer": "14.2.3",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.12",
    "@vercel/analytics": "^1.2.2",
    "autoprefixer": "^10.4.13",
    "echarts": "5.4.3",
    "github-slugger": "^2.0.0",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "katex": "^0.16.10",
    "lodash": "^4.17.21",
    "next": "14.2.3",
    "next-themes": "^0.3.0",
    "papaparse": "^5.4.1",
    "pliny": "0.2.1",
    "postcss": "^8.4.24",
    "pretty-bytes": "^6.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.0",
    "rehype-preset-minify": "7.0.0",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-github-blockquote-alert": "^1.2.1",
    "remark-math": "^6.0.0",
    "rust-wasm": "./rust-wasm/pkg",
    "tailwindcss": "^3.4.3"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.202",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.2.73",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "concurrently": "^10.0.4",
    "cross-env": "^7.0.3",
    "cspell": "^8.3.2",
    "cypress": "^13.13.2",
    "eslint": "^8.45.0",
    "eslint-config-next": "14.2.3",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "sitemapper": "^3.2.9",
    "typescript": "^5.1.3",
    "velite": "^0.4.0",
    "vercel": "^48.4.1"
  },
  "resolutions": {
    "string-width": "^4.2.3",
    "wrap-ansi": "^7.0.0"
  }
}
