{
  "name": "scientific-witchery",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n content,next -c blue,magenta \"velite build --watch\" \"next dev\"",
    "build": "NODE_ENV=production velite build && next build && node ./scripts/postbuild.mjs",
    "start": "next start",
    "content": "NODE_ENV=production velite build",
    "wasm": "cd rust-wasm && wasm-pack build --target bundler --out-dir pkg && rm -f pkg/.gitignore",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "spell": "cspell data/blog/**/*.mdx"
  },
  "dependencies": {
    "@headlessui/react": "1.7.19",
    "@kbox-labs/react-echarts": "1.0.3",
    "@next/bundle-analyzer": "14.2.3",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.12",
    "@vercel/analytics": "^1.2.2",
    "echarts": "5.4.3",
    "github-slugger": "^2.0.0",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "katex": "^0.16.10",
    "lodash": "^4.17.21",
    "next": "16.2.12",
    "next-themes": "^0.3.0",
    "papaparse": "^5.4.1",
    "pliny": "0.2.1",
    "pretty-bytes": "^6.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.0",
    "rehype-preset-minify": "7.0.0",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-github-blockquote-alert": "^1.2.1",
    "remark-math": "^6.0.0",
    "rust-wasm": "./rust-wasm/pkg"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.4",
    "cross-env": "^7.0.3",
    "cspell": "^8.3.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "velite": "^0.4.0",
    "vercel": "^48.4.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "resolutions": {
    "string-width": "^4.2.3",
    "wrap-ansi": "^7.0.0"
  }
}
